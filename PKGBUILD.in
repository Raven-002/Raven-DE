# This is an example PKGBUILD file. Use this as a start to creating your own,
# and remove these comments. For more information, see 'man PKGBUILD'.
# NOTE: Please fill out the license field for your package! If it is unknown,
# then please put 'unknown'.

# Maintainer: Your Name <youremail@domain.com>
pkgname=raven-kde
pkgver=@PKGVER@
pkgrel=1
epoch=
pkgdesc="Desktop configuration"
arch=('any')
url="https://github.com/Raven-002/arch-raven"
license=('GPL')
groups=()
depends=(
    # Base
    base-devel
    posix
    sudo
    xdg-user-dirs
    
    # File systems
    btrfs-progs
    dosfstools
    exfatprogs

    # Communication
    networkmanager
    bluez
    bluez-utils
    pipewire
    pipewire-jack
    pipewire-pulse
    pavucontrol-qt
    wireplumber

    # Editors
    nano
    vi
    vim
    neovim

    # basic
    git
    wget
    curl
    openssh
    posix-c-development
    posix-software-development
    posix-user-portability
    posix-xsi
    zip
    unzip
    
    # Shells
    zsh
    sh
    bash

    # Graphics
    libva-utils

    # Backups
    timeshift
    
    # Extra
    strace
    htop
    neofetch
    fastfetch
    ripgrep
    tree
    btop
    samba

    # Fonts
    ttf-firacode-nerd
    ttf-iosevka-nerd
    ttf-noto-nerd
    ttf-nerd-fonts-symbols
    ttf-nerd-fonts-symbols-common
    ttf-nerd-fonts-symbols-mono
    ttf-font-awesome
    noto-fonts
    ttf-dejavu
    
    # Wayland utilities
    grim
    slurp
    
    # Extra GUI
    kitty
    flatpak
    firefox
    vlc
    gparted

    # KDE
    wayland
    plasma-meta
    kde-applications-meta
    tesseract-data-eng # Dependency of kde
    )
makedepends=()
checkdepends=()
optdepends=(
    # Base
    base
    linux
    linux-firmware
    grub
    efibootmgr
    os-prober
    )
provides=('raven-de')
conflicts=('raven-de')
replaces=()
backup=()
options=()
install=
changelog=
source=()
noextract=()
sha256sums=()
validpgpkeys=()

prepare() {
	ln -snfT "$startdir" "$srcdir/$pkgname-$pkgver"
}

package() {
    # Make directories
    mkdir -p \
        $pkgdir/usr/bin \
        $pkgdir/usr/share/raven-de \
        $pkgdir/usr/share/application

    # Copy folders
    cp --recursive --no-dereference --no-target-directory $srcdir/$pkgname-$pkgver/raven-de $pkgdir/usr/share/raven-de
    cp --recursive --no-dereference --no-target-directory $srcdir/$pkgname-$pkgver/applications $pkgdir/usr/share/applications
    cp --recursive --no-dereference $srcdir/$pkgname-$pkgver/binaries/* $pkgdir/usr/bin/
    rm -rf $pkgdir/usr/share/raven-de/config-files/zsh/oh-my-zsh
    
    # Symlink scripts
    ln -srT $pkgdir/usr/share/raven-de/raven-de-installer $pkgdir/usr/bin/raven-de-installer
}

post_install() {
    echo "Configs are saved in /usr/share/raven-de"
}
