# *** Imports ******************************************************************
import inquirer
import inquirer.themes
import os
import logging
import sys
import inspect

from abc import ABC, abstractmethod
from enum import Enum
from typing import Any, Optional, override
from colorlog import ColoredFormatter


# *** Globals ******************************************************************
logger = logging.getLogger()
is_dry_run: bool = True


# *** Constants ****************************************************************


# *** Objects ******************************************************************
class ContextFilter(logging.Filter):
    """
    Custom logging filter to add context information.
    """

    def __init__(self):
        super().__init__()

    def filter(self, record: logging.LogRecord) -> bool:
        stack = inspect.stack()
        classes = []

        for frame_info in reversed(stack):
            frame = frame_info.frame
            # Get the instance (self) if it exists in the frame's local variables
            instance = frame.f_locals.get("self", None)
            if instance:
                cls_name = type(instance).__name__
                if cls_name in ["RootLogger", "Logger", "ContextFilter"]:
                    break
                if classes and cls_name == classes[-1]:
                    continue
                classes.append(cls_name)

        record.context = "->".join([f"{c}" for c in classes])
        return True


class CommandsRunner:
    """
    Class to run commands in the shell.
    """

    RETURN_INDEX_STATUS = 0
    RETURN_INDEX_STDOUT = 1
    RETURN_INDEX_STDERR = 2

    def __init__(self):
        pass

    def run_command(
        self,
        command,
        args: Optional[list[str]] = None,
        allow_error: bool = False,
        ignore_dry_run: bool = False,
    ) -> Optional[tuple[int, str, str]]:
        """
        Run a shell command.
        :param command: The command to run.
        :param args: The arguments to pass to the command.
        :param allow_error: Whether to allow errors.
        :return: The return code, stdout, and stderr.
        """
        import subprocess

        logger.info(f'Running command: "{command}" with args: {args}')
        if is_dry_run and not ignore_dry_run:
            logger.debug(f"Dry run mode.")
            return None
        command_args = [command] + args if args else [command]
        result = subprocess.run(
            command_args, shell=False, capture_output=True, text=True
        )
        if result.stdout:
            logger.debug(f"Command output: {result.stdout.strip()}")
        if result.stderr:
            logger.warning(f"Command error: {result.stderr.strip()}")
        if not allow_error and result.returncode != 0:
            logger.error(f"Command failed with return value: {result.returncode}")
            raise Exception(
                f"Command failed: {result.returncode} {result.stderr.strip()}"
            )
        return result.returncode, result.stdout.strip(), result.stderr.strip()


class FileSystemController:
    """
    Class to control the file system.
    """

    def __init__(self):
        pass

    def create_directory(self, path: str) -> None:
        """
        Create a directory.
        :param path: The path to create.
        """
        logger.info(f"Creating directory: {path}")
        if is_dry_run:
            logger.debug(f"Dry run mode.")
            return

        try:
            os.makedirs(path, exist_ok=True)
            logger.debug(f"Directory created: {path}")
        except Exception as e:
            logger.error(f"Failed to create directory: {e}")
            raise

    def remove_directory(self, path: str) -> None:
        """
        Remove a directory.
        :param path: The path to remove.
        """
        logger.info(f"Removing directory: {path}")
        if is_dry_run:
            logger.debug(f"Dry run mode.")
            return

        try:
            os.rmdir(path)
            logger.debug(f"Directory removed: {path}")
        except Exception as e:
            logger.error(f"Failed to remove directory: {e}")
            raise

    def exists(self, path: str) -> bool:
        """
        Check if a file exists.
        :param path: The path to check.
        :return: True if the file exists, False otherwise.
        """
        logger.debug(f"Checking if file exists: {path}")
        exists = os.path.exists(path)
        logger.debug(f"File exists: {exists}")
        return exists

    def is_directory(self, path: str) -> bool:
        """
        Check if a path is a directory.
        :param path: The path to check.
        :return: True if the path is a directory, False otherwise.
        """
        logger.debug(f"Checking if path is a directory: {path}")
        is_dir = os.path.isdir(path)
        if is_dir:
            logger.debug(f"Path is a directory: {path}")
        else:
            logger.debug(f"Path is not a directory: {path}")
        return is_dir

    def is_file(self, path: str) -> bool:
        """
        Check if a path is a file.
        :param path: The path to check.
        :return: True if the path is a file, False otherwise.
        """
        logger.debug(f"Checking if path is a file: {path}")
        is_file = os.path.isfile(path)
        logger.debug(f"Path is a file: {is_file}")
        return is_file

    def assert_exists(self, path: str, message: Optional[str] = None) -> None:
        """
        Assert that a path exists.
        :param path: The path to check.
        """
        logger.debug(f"Asserting path exists: {path}")
        if is_dry_run:
            logger.debug(f"Dry run mode.")
            return

        if not self.exists(path):
            error_message = message or f"Path not found: {path}"
            raise FileNotFoundError(error_message)

    def assert_file_exists(self, path: str, message: Optional[str] = None) -> None:
        """
        Assert that a file exists.
        :param path: The path to check.
        """
        logger.debug(f"Asserting file exists: {path}")
        if is_dry_run:
            logger.debug(f"Dry run mode.")
            return

        if not self.is_file(path):
            error_message = message or f"File not found: {path}"
            raise FileNotFoundError(error_message)

    def assert_directory_exists(self, path: str, message: Optional[str] = None) -> None:
        """
        Assert that a directory exists.
        :param path: The path to check.
        """
        logger.debug(f"Asserting directory exists: {path}")
        if is_dry_run:
            logger.debug(f"Dry run mode.")
            return

        if not self.is_directory(path):
            error_message = message or f"Directory not found: {path}"
            raise NotADirectoryError(error_message)

    def assert_symlink(self, path: str) -> None:
        """
        Assert that a path is a symbolic link.
        :param path: The path to check.
        """
        logger.debug(f"Asserting symlink: {path}")
        if is_dry_run:
            logger.debug(f"Dry run mode.")
            return

        if not self.is_symlink(path):
            raise FileNotFoundError(f"Symlink not found: {path}")

    def assert_not_exists(self, path: str) -> None:
        """
        Assert that a path does not exist.
        :param path: The path to check.
        """
        logger.debug(f"Asserting path does not exist: {path}")
        if is_dry_run:
            logger.debug(f"Dry run mode.")
            return

        if self.exists(path):
            raise FileExistsError(f"Path exists: {path}")

    def remove_file(self, path: str) -> None:
        """
        Remove a file.
        :param path: The path to remove.
        """
        logger.info(f"Removing file: {path}")
        if is_dry_run:
            logger.debug(f"Dry run mode.")
            return

        try:
            os.remove(path)
            logger.debug(f"File removed: {path}")
        except Exception as e:
            logger.error(f"Failed to remove file: {e}")
            raise

    def create_symlink(self, target: str, link_name: str) -> None:
        """
        Create a symbolic link.
        :param target: The target file.
        :param link_name: The name of the symbolic link.
        """
        logger.info(f"Creating symbolic link: {link_name} -> {target}")
        if is_dry_run:
            logger.debug(f"Dry run mode.")
            return

        try:
            os.symlink(target, link_name)
            logger.debug(f"Symbolic link created: {link_name} -> {target}")
        except Exception as e:
            logger.error(f"Failed to create symbolic link: {e}")
            raise

    def is_symlink(self, path: str) -> bool:
        """
        Check if a path is a symbolic link.
        :param path: The path to check.
        :return: True if the path is a symbolic link, False otherwise.
        """
        logger.debug(f"Checking if path is a symbolic link: {path}")
        if is_dry_run:
            logger.debug(f"Dry run mode.")
            return False

        is_link = os.path.islink(path)
        logger.debug(f"Path is a symbolic link: {is_link}")
        return is_link

    def copy_file(self, source: str, destination: str) -> None:
        """
        Copy a file.
        :param source: The source file.
        :param destination: The destination file.
        """
        logger.info(f"Copying file: {source} -> {destination}")
        if is_dry_run:
            logger.debug(f"Dry run mode.")
            return

        try:
            with open(source, "rb") as src_file:
                with open(destination, "wb") as dest_file:
                    dest_file.write(src_file.read())
            logger.debug(f"File copied: {source} -> {destination}")
        except Exception as e:
            logger.error(f"Failed to copy file: {e}")
            raise

    def expanduser(self, path: str) -> str:
        """
        Expand the user directory in a path.
        :param path: The path to expand.
        :return: The expanded path.
        """
        return os.path.expanduser(path)

    def get_home_directory(self) -> str:
        """
        Get the home directory.
        :return: The home directory.
        """
        return os.path.expanduser("~")

    def join(self, *paths: str) -> str:
        """
        Join paths.
        :param paths: The paths to join.
        :return: The joined path.
        """
        return os.path.join(*paths)


class PromptManager:
    """
    Class to manage prompts.
    """

    def __init__(self):
        pass

    def _prompt(self, questions: list[Any]) -> dict[str, str]:
        """
        Prompt the user for input.
        :param questions: The questions to ask.
        :return: The user's answers.
        """
        answers = inquirer.prompt(questions, theme=inquirer.themes.Default())
        if not answers:
            raise Exception("No answer provided.")
        return answers

    def display_message(self, message: str) -> None:
        """
        Display a message to the user.
        :param message: The message to display.
        """
        print(message)

    def prompt(self, message: str, default: Optional[str] = None) -> str:
        """
        Prompt the user for input.
        :param message: The message to display.
        :param default: The default value.
        :return: The user's input.
        """
        questions = [
            inquirer.Text("value", message=message, default=default),
        ]
        answers = self._prompt(questions)
        return answers["value"]

    def prompt_yes_no(self, message: str, default: Optional[bool] = None) -> bool:
        """
        Prompt the user for a yes/no answer.
        :param message: The message to display.
        :param default: The default value.
        :return: True if yes, False if no.
        """
        questions = [
            inquirer.Confirm("value", message=message, default=default),
        ]
        answers = self._prompt(questions)
        return answers["value"]

    def prompt_password(self, message: str) -> str:
        """
        Prompt the user for a password.
        :param message: The message to display.
        :return: The user's password.
        """
        questions = [
            inquirer.Password("value", message=message),
        ]
        answers = self._prompt(questions)
        return answers["value"]

    def prompt_select(
        self, message: str, choices: list[str], default: Optional[str] = None
    ) -> str:
        """
        Prompt the user to select from a list of choices.
        :param message: The message to display.
        :param choices: The list of choices.
        :param default: The default value.
        :return: The user's selection.
        """
        questions = [
            inquirer.List("value", message=message, choices=choices, default=default),
        ]
        answers = self._prompt(questions)
        return answers["value"]

    def prompt_checkbox(
        self,
        message: str,
        choices: list[str],
        default: Optional[list[str]] = None,
        allow_empty: bool = False,
    ) -> list[str]:
        """
        Prompt the user to select multiple choices.
        :param message: The message to display.
        :param choices: The list of choices.
        :param default: The default values.
        :return: The user's selections.
        """
        questions = [
            inquirer.Checkbox(
                "value", message=message, choices=choices, default=default
            ),
        ]
        answers = self._prompt(questions)
        answer = answers["value"]
        assert isinstance(answer, list), "Answer is not a list."
        if len(answer) == 0 and not allow_empty:
            raise Exception("No answer provided.")
        return answer


class ConfigurationObject(ABC):
    """
    Abstract class for configuration objects.
    """

    def __init__(self):
        """
        Initialize the configuration object.
        """
        if is_dry_run:
            self.__should_be_configured: bool = False

    @property
    @abstractmethod
    def dependencies(self) -> list["ConfigurationObject"]:
        """
        Get the dependencies of the configuration object.
        :return: The dependencies of the configuration object.
        """
        pass

    @property
    @abstractmethod
    def name(self) -> str:
        """
        Get the name of the configuration object.
        :return: The name of the configuration object.
        """
        pass

    @abstractmethod
    def get_state(self) -> str:
        """
        Get the configuration object's state.
        :return: The configuration object's state as a string.
        """
        pass

    def configure(self, override: bool = False) -> None:
        """
        Configure the configuration object.
        """
        is_override = False
        if self.check_if_configured():
            if not override:
                logger.warning(
                    f"{self.name} is already configured, nothing to configure."
                )
                return
            logger.info(f"{self.name} is already configured, overriding configuration.")
            is_override = True

        for dependency in self.dependencies:
            if not dependency.check_if_configured():
                logger.warning(
                    f"{self.name} dependency {dependency.name} is not configured."
                )
                raise Exception(
                    f"{self.name} dependency {dependency.name} is not configured."
                )

        logger.info(f"Configuring {self.name}.")
        try:
            self._configure(is_override)
            logger.debug(f"{self.name} configured successfully.")
        except Exception as e:
            logger.error(f"{self.name} configuration failed: {e}")
            raise

        if is_dry_run:
            self.__should_be_configured = True

    @abstractmethod
    def _configure(self, is_override: bool) -> None:
        """
        Configure the configuration object.
        :param is_override: Whether to override the configuration.
        """
        pass

    def validate(self) -> None:
        """
        Validate the configuration object.
        """
        logger.info(f"Validating {self.name}.")
        if is_dry_run and self.__should_be_configured:
            logger.debug(f"Dry run mode.")
            return
        try:
            self._validate()
            logger.debug(f"{self.name} validated successfully.")
        except Exception as e:
            logger.error(f"{self.name} validation failed: {e}")
            raise

    @abstractmethod
    def _validate(self) -> None:
        """
        Validate the configuration object.
        """
        pass

    def check_if_configured(self) -> bool:
        """
        Check if the configuration object is configured.
        :return: True if configured, False otherwise.
        """
        if is_dry_run and self.__should_be_configured:
            logger.debug(f"{self.name} is configured in dry run mode.")
            return True

        if not self._check_if_configured():
            logger.debug(f"{self.name} is not configured.")
            return False

        logger.debug(f"{self.name} is configured, checking dependencies.")
        missing_dependencies = []
        for dependency in self.dependencies:
            if not dependency.check_if_configured():
                logger.debug(
                    f"{self.name} dependency {dependency.name} is not configured."
                )
                missing_dependencies.append(dependency.name)

        is_configured = len(missing_dependencies) == 0

        if is_dry_run and is_configured:
            self.__should_be_configured = True

        return is_configured

    @abstractmethod
    def _check_if_configured(self) -> bool:
        """
        Check if the configuration object is configured.
        :return: True if configured, False otherwise.
        """
        pass

    def unconfigure(self) -> None:
        """
        Unconfigure the configuration object.
        """
        if not self.check_if_configured():
            logger.warning(f"{self.name} is not configured, nothing to unconfigure.")
            return

        logger.info(f"Unconfiguring configuration object.")
        try:
            self._unconfigure()
            logger.info(f"{self.name} unconfigured successfully.")
        except Exception as e:
            logger.error(f"{self.name} unconfiguration failed: {e}")
            raise

        if is_dry_run:
            self.__should_be_configured = False

        logger.info(f"{self.name} state: {self.get_state()}")

    @abstractmethod
    def _unconfigure(self) -> None:
        """
        Unconfigure the configuration object.
        """
        pass


# *** Concrete Configuration Objects *******************************************
class UserGitConfiguration(ConfigurationObject):
    def __init__(self, prompt_manager: PromptManager, commands_runner: CommandsRunner):
        """
        Initialize the UserGitConfiguration object.
        :param prompt_manager: The prompt manager.
        :param commands_runner: The commands runner.
        """
        super().__init__()
        self._prompt_manager: PromptManager = prompt_manager
        self._commands_runner: CommandsRunner = commands_runner

    @property
    @override
    def dependencies(self) -> list[ConfigurationObject]:
        return []

    @property
    @override
    def name(self) -> str:
        return "User Git Configuration"

    def get_username(self) -> str:
        git_config_user_name = self._commands_runner.run_command(
            "git", args=["config", "--global", "user.name"], ignore_dry_run=True
        )
        return (
            git_config_user_name[self._commands_runner.RETURN_INDEX_STDOUT].strip()
            if git_config_user_name
            else ""
        )

    def get_email(self) -> str:
        git_config_user_email = self._commands_runner.run_command(
            "git", args=["config", "--global", "user.email"], ignore_dry_run=True
        )
        return (
            git_config_user_email[self._commands_runner.RETURN_INDEX_STDOUT].strip()
            if git_config_user_email
            else ""
        )

    @override
    def get_state(self) -> str:
        username = self.get_username()
        email = self.get_email()
        if username and email:
            return f'Configured with username: "{username}" and email: "{email}"'
        return "Not Configured"

    @override
    def _configure(self, is_override: bool) -> None:
        username = self._prompt_manager.prompt(
            "Enter your git username", default=self.get_username()
        )
        assert username, "Git username cannot be empty."

        email = self._prompt_manager.prompt(
            "Enter your git email", default=self.get_email()
        )
        assert email, "Git email cannot be empty."

        logger.info(f'Configuring git with username: "{username}" and email: "{email}"')
        self._commands_runner.run_command(
            "git", args=["config", "--global", "user.name", username]
        )
        self._commands_runner.run_command(
            "git", args=["config", "--global", "user.email", email]
        )

    @override
    def _validate(self) -> None:
        assert self.get_username(), "Git username is not configured."
        assert self.get_email(), "Git email is not configured."

    @override
    def _check_if_configured(self) -> bool:
        username = self.get_username()
        email = self.get_email()
        return username and email

    @override
    def _unconfigure(self) -> None:
        logger.warning("Not implemented yet.")


class UserDirectoryConfiguration(ConfigurationObject):
    def __init__(
        self,
        commands_runner: CommandsRunner,
        file_system_controller: FileSystemController,
        configuration_path: str,
        git_configuration: UserGitConfiguration,
    ):
        """
        Initialize the UserDirectoryConfiguration object.
        :param commands_runner: The commands runner.
        :param file_system_controller: The file system controller.
        :param configuration_path: The path to the user directory.
        :param git_configuration: The git configuration object.
        """
        super().__init__()
        self._commands_runner: CommandsRunner = commands_runner
        self._file_system_controller: FileSystemController = file_system_controller
        self._user_directory: str = file_system_controller.expanduser(
            configuration_path
        )
        self._git_configuration: UserGitConfiguration = git_configuration

    @property
    @override
    def dependencies(self) -> list[ConfigurationObject]:
        return [self._git_configuration]

    @property
    @override
    def name(self) -> str:
        return "User Directory Configuration"

    @property
    @override
    def user_directory(self) -> str:
        return self._user_directory

    @property
    def _git_directory(self) -> str:
        return self._file_system_controller.join(self.user_directory, ".git")

    @override
    def get_state(self) -> str:
        try:
            if self.check_if_configured():
                return "Not Configured"
            self.validate()
            return "Configured"
        except Exception as e:
            return f"Not Configured correctly: {str(e)}"

    @override
    def _configure(self, is_override: bool) -> None:
        assert (
            not is_override
        ), "Overriding user directory configuration is not allowed."
        self._file_system_controller.create_directory(self.user_directory)
        self._commands_runner.run_command("git init", [self.user_directory])

    @override
    def _validate(self) -> None:
        self._file_system_controller.assert_directory_exists(
            self.user_directory,
            f"User directory {self.user_directory} does not exist.",
        )
        self._file_system_controller.assert_directory_exists(
            self._git_directory,
            f"User directory {self.user_directory} is not a git repository.",
        )

    @override
    def _check_if_configured(self) -> bool:
        if not self._file_system_controller.exists(self.user_directory):
            return False
        if not self._file_system_controller.is_directory(self.user_directory):
            raise Exception(
                f"User directory {self.user_directory} exists but is not a directory. Consider removing it."
            )

    @override
    def _unconfigure(self) -> None:
        self._file_system_controller.remove_directory(self.user_directory)


# *** Functions ****************************************************************
def setup_logging(
    level: int, console_level: Optional[int] = None, file_path: Optional[str] = None
) -> None:
    logger.setLevel(level)
    logger.addFilter(ContextFilter())
    format = (
        "[%(asctime)s][%(levelname)s][%(context)s] %(filename)s:%(lineno)d: %(message)s"
    )
    formatter = logging.Formatter(format)
    color_formatter = ColoredFormatter(
        "%(log_color)s" + format,
        reset=True,
        log_colors={
            "DEBUG": "cyan",
            "INFO": "green",
            "WARNING": "yellow",
            "ERROR": "red",
            "CRITICAL": "red,bg_white",
        },
    )
    console_handler = logging.StreamHandler(sys.stdout)
    console_handler.setFormatter(color_formatter)
    console_handler.setLevel(console_level or level)
    logger.addHandler(console_handler)
    if file_path:
        file_handler = logging.FileHandler(file_path)
        file_handler.setFormatter(formatter)
        file_handler.setLevel(level)
        logger.addHandler(file_handler)


def get_configuration_objects(
    prompt_manager: PromptManager,
    file_system_controller: FileSystemController,
    commands_runner: CommandsRunner,
) -> list[ConfigurationObject]:
    """
    Get the list of configuration objects.
    :return: The list of configuration objects.
    """
    configurations: list[ConfigurationObject] = []

    user_git_configuration = UserGitConfiguration(
        prompt_manager=prompt_manager, commands_runner=commands_runner
    )
    configurations.append(user_git_configuration)

    user_directory = os.path.join(
        file_system_controller.get_home_directory(), ".config", "raven-de"
    )
    user_directory_configuration = UserDirectoryConfiguration(
        commands_runner=commands_runner,
        file_system_controller=file_system_controller,
        configuration_path=user_directory,
        git_configuration=user_git_configuration,
    )
    configurations.append(user_directory_configuration)

    return configurations


def select_configuration_objects(
    configurations: list[ConfigurationObject],
    prompt_manager: PromptManager,
) -> list[ConfigurationObject]:
    """
    Select configuration objects to configure.
    :param configurations: The list of configuration objects.
    :return: The selected configuration objects.
    """
    choices = [config.name for config in configurations]
    selected_choices = prompt_manager.prompt_checkbox(
        message="Select configurations to run", choices=choices, allow_empty=False
    )

    selected_configurations = [
        config for config in configurations if config.name in selected_choices
    ]
    return selected_configurations


def get_dependencies(
    configurations: list[ConfigurationObject],
) -> list[ConfigurationObject]:
    """
    Get the dependencies of the selected configuration objects, while checking for cycles.
    :param configurations: The list of configuration objects.
    :return: The list of dependencies.
    """
    visited: set[ConfigurationObject] = set()
    stack: set[ConfigurationObject] = set()
    cycles: list[list[ConfigurationObject]] = []

    logger.debug("Resolving dependencies...")

    def visit(obj: ConfigurationObject):
        if obj in stack:
            cycles.append(list(stack))
            return
        if obj in visited:
            return
        visited.add(obj)
        stack.add(obj)
        for dep in obj.dependencies:
            visit(dep)
        stack.remove(obj)

    for obj in configurations:
        visit(obj)

    if cycles:
        logger.error("Cycles detected in dependencies:")
        for cycle in cycles:
            logger.error(f" - Cycle: {[obj.name for obj in cycle]}")
        raise Exception("Cycles detected in dependencies.")

    logger.debug("Dependencies resolved successfully.")

    return visited


# *** Main *********************************************************************
def main():
    """
    Main function to run the Raven DE installer.
    """
    setup_logging(logging.DEBUG, logging.INFO)
    logger.info("Starting Raven DE installer.")

    global is_dry_run
    is_dry_run = True
    logger.info("Running in dry run mode.")

    prompt_manager = PromptManager()
    commands_runner = CommandsRunner()
    file_system_controller = FileSystemController()

    configurations = get_configuration_objects(
        prompt_manager, file_system_controller, commands_runner
    )
    logger.info("Loaded configuration objects:")
    for config in configurations:
        logger.info(f" - {config.name}")

    selected_configurations = select_configuration_objects(
        configurations, prompt_manager
    )
    logger.info("Selected configuration objects:")
    for config in selected_configurations:
        logger.info(f" - {config.name}")

    dependencies = get_dependencies(selected_configurations)
    logger.info("Resolved dependencies:")
    for config in dependencies:
        logger.info(f" - {config.name}")

    prompt_manager.display_message(
        "The following configurations will be run:\n"
        + "\n".join([f" - {config.name}" for config in dependencies])
        + "\n"
    )
    if not prompt_manager.prompt_yes_no(
        "Do you want to continue?",
        default=True,
    ):
        logger.info("Installation cancelled by user.")
        return
    logger.info("Continuing with the installation.")


if __name__ == "__main__":
    main()
