# *** Imports ******************************************************************
import inquirer
import os
import logging
import sys
import inspect

from abc import ABC, abstractmethod
from enum import Enum
from typing import Optional, override
from colorlog import ColoredFormatter


# *** Globals ******************************************************************
logger = logging.getLogger()


# *** Constants ****************************************************************


# *** Objects ******************************************************************
class ContextFilter(logging.Filter):
    """
    Custom logging filter to add context information.
    """

    def __init__(self):
        super().__init__()

    def filter(self, record: logging.LogRecord) -> bool:
        stack = inspect.stack()
        classes = []

        for frame_info in reversed(stack):
            frame = frame_info.frame
            # Get the instance (self) if it exists in the frame's local variables
            instance = frame.f_locals.get("self", None)
            if instance:
                cls_name = type(instance).__name__
                if cls_name in ["RootLogger", "Logger", "ContextFilter"]:
                    break
                if classes and cls_name == classes[-1]:
                    continue
                classes.append(cls_name)

        record.context = "->".join([f"{c}" for c in classes])
        return True


class CommandsRunner:
    """
    Class to run commands in the shell.
    """

    def __init__(self, dry_run: bool):
        self._dry_run: bool = dry_run
        pass

    def run_command(
        self, command, args: Optional[list[str]] = None, allow_error: bool = False
    ) -> Optional[tuple[int, str, str]]:
        """
        Run a shell command.
        :param command: The command to run.
        :param args: The arguments to pass to the command.
        :param allow_error: Whether to allow errors.
        :return: The return code, stdout, and stderr.
        """
        import subprocess

        logger.info(f"Running command: {command}")
        if self._dry_run:
            logger.debug(f"Dry run mode.")
            return None
        result = subprocess.run(command, shell=True, capture_output=True, text=True)
        if result.stdout:
            logger.debug(f"Command output: {result.stdout.strip()}")
        if result.stderr:
            logger.warning(f"Command error: {result.stderr.strip()}")
        if not allow_error and result.returncode != 0:
            logger.error(f"Command failed with return value: {result.returncode}")
            raise Exception(
                f"Command failed: {result.returncode} {result.stderr.strip()}"
            )
        return result.returncode, result.stdout.strip(), result.stderr.strip()


class FileSystemController:
    """
    Class to control the file system.
    """

    def __init__(self, dry_run: bool):
        self._dry_run: bool = dry_run
        pass

    def create_directory(self, path: str) -> None:
        """
        Create a directory.
        :param path: The path to create.
        """
        logger.info(f"Creating directory: {path}")
        if self._dry_run:
            logger.debug(f"Dry run mode.")
            return

        try:
            os.makedirs(path, exist_ok=True)
            logger.debug(f"Directory created: {path}")
        except Exception as e:
            logger.error(f"Failed to create directory: {e}")
            raise

    def remove_directory(self, path: str) -> None:
        """
        Remove a directory.
        :param path: The path to remove.
        """
        logger.info(f"Removing directory: {path}")
        if self._dry_run:
            logger.debug(f"Dry run mode.")
            return

        try:
            os.rmdir(path)
            logger.debug(f"Directory removed: {path}")
        except Exception as e:
            logger.error(f"Failed to remove directory: {e}")
            raise

    def exists(self, path: str) -> bool:
        """
        Check if a file exists.
        :param path: The path to check.
        :return: True if the file exists, False otherwise.
        """
        logger.debug(f"Checking if file exists: {path}")
        exists = os.path.exists(path)
        logger.debug(f"File exists: {exists}")
        return exists

    def is_directory(self, path: str) -> bool:
        """
        Check if a path is a directory.
        :param path: The path to check.
        :return: True if the path is a directory, False otherwise.
        """
        logger.debug(f"Checking if path is a directory: {path}")
        is_dir = os.path.isdir(path)
        if is_dir:
            logger.debug(f"Path is a directory: {path}")
        else:
            logger.debug(f"Path is not a directory: {path}")
        return is_dir

    def is_file(self, path: str) -> bool:
        """
        Check if a path is a file.
        :param path: The path to check.
        :return: True if the path is a file, False otherwise.
        """
        logger.debug(f"Checking if path is a file: {path}")
        is_file = os.path.isfile(path)
        logger.debug(f"Path is a file: {is_file}")
        return is_file

    def assert_exists(self, path: str, message: Optional[str] = None) -> None:
        """
        Assert that a path exists.
        :param path: The path to check.
        """
        logger.debug(f"Asserting path exists: {path}")
        if self._dry_run:
            logger.debug(f"Dry run mode.")
            return

        if not self.exists(path):
            error_message = message or f"Path not found: {path}"
            raise FileNotFoundError(error_message)

    def assert_file_exists(self, path: str, message: Optional[str] = None) -> None:
        """
        Assert that a file exists.
        :param path: The path to check.
        """
        logger.debug(f"Asserting file exists: {path}")
        if self._dry_run:
            logger.debug(f"Dry run mode.")
            return

        if not self.is_file(path):
            error_message = message or f"File not found: {path}"
            raise FileNotFoundError(error_message)

    def assert_directory_exists(self, path: str, message: Optional[str] = None) -> None:
        """
        Assert that a directory exists.
        :param path: The path to check.
        """
        logger.debug(f"Asserting directory exists: {path}")
        if self._dry_run:
            logger.debug(f"Dry run mode.")
            return

        if not self.is_directory(path):
            error_message = message or f"Directory not found: {path}"
            raise NotADirectoryError(error_message)

    def assert_symlink(self, path: str) -> None:
        """
        Assert that a path is a symbolic link.
        :param path: The path to check.
        """
        logger.debug(f"Asserting symlink: {path}")
        if self._dry_run:
            logger.debug(f"Dry run mode.")
            return

        if not self.is_symlink(path):
            raise FileNotFoundError(f"Symlink not found: {path}")

    def assert_not_exists(self, path: str) -> None:
        """
        Assert that a path does not exist.
        :param path: The path to check.
        """
        logger.debug(f"Asserting path does not exist: {path}")
        if self._dry_run:
            logger.debug(f"Dry run mode.")
            return

        if self.exists(path):
            raise FileExistsError(f"Path exists: {path}")

    def remove_file(self, path: str) -> None:
        """
        Remove a file.
        :param path: The path to remove.
        """
        logger.info(f"Removing file: {path}")
        if self._dry_run:
            logger.debug(f"Dry run mode.")
            return

        try:
            os.remove(path)
            logger.debug(f"File removed: {path}")
        except Exception as e:
            logger.error(f"Failed to remove file: {e}")
            raise

    def create_symlink(self, target: str, link_name: str) -> None:
        """
        Create a symbolic link.
        :param target: The target file.
        :param link_name: The name of the symbolic link.
        """
        logger.info(f"Creating symbolic link: {link_name} -> {target}")
        if self._dry_run:
            logger.debug(f"Dry run mode.")
            return

        try:
            os.symlink(target, link_name)
            logger.debug(f"Symbolic link created: {link_name} -> {target}")
        except Exception as e:
            logger.error(f"Failed to create symbolic link: {e}")
            raise

    def is_symlink(self, path: str) -> bool:
        """
        Check if a path is a symbolic link.
        :param path: The path to check.
        :return: True if the path is a symbolic link, False otherwise.
        """
        logger.debug(f"Checking if path is a symbolic link: {path}")
        if self._dry_run:
            logger.debug(f"Dry run mode.")
            return False

        is_link = os.path.islink(path)
        logger.debug(f"Path is a symbolic link: {is_link}")
        return is_link

    def copy_file(self, source: str, destination: str) -> None:
        """
        Copy a file.
        :param source: The source file.
        :param destination: The destination file.
        """
        logger.info(f"Copying file: {source} -> {destination}")
        if self._dry_run:
            logger.debug(f"Dry run mode.")
            return

        try:
            with open(source, "rb") as src_file:
                with open(destination, "wb") as dest_file:
                    dest_file.write(src_file.read())
            logger.debug(f"File copied: {source} -> {destination}")
        except Exception as e:
            logger.error(f"Failed to copy file: {e}")
            raise

    def expanduser(self, path: str) -> str:
        """
        Expand the user directory in a path.
        :param path: The path to expand.
        :return: The expanded path.
        """
        return os.path.expanduser(path)

    def get_home_directory(self) -> str:
        """
        Get the home directory.
        :return: The home directory.
        """
        return os.path.expanduser("~")

    def join(self, *paths: str) -> str:
        """
        Join paths.
        :param paths: The paths to join.
        :return: The joined path.
        """
        return os.path.join(*paths)


class ConfigurationObject(ABC):
    """
    Abstract class for configuration objects.
    """

    @property
    @abstractmethod
    def dependencies(self) -> list["ConfigurationObject"]:
        """
        Get the dependencies of the configuration object.
        :return: The dependencies of the configuration object.
        """
        pass

    @property
    @abstractmethod
    def name(self) -> str:
        """
        Get the name of the configuration object.
        :return: The name of the configuration object.
        """
        pass

    @abstractmethod
    def get_state(self) -> str:
        """
        Get the configuration object's state.
        :return: The configuration object's state as a string.
        """
        pass

    def configure(self) -> None:
        """
        Configure the configuration object.
        """
        if self.check_if_configured():
            logger.warning(f"{self.name} is already configured, nothing to configure.")
            return

        logger.info(f"Configuring {self.name}.")
        try:
            self._configure()
            logger.debug(f"{self.name} configured successfully.")
        except Exception as e:
            logger.error(f"{self.name} configuration failed: {e}")
            raise

    @abstractmethod
    def _configure(self) -> None:
        """
        Configure the configuration object.
        """
        pass

    @abstractmethod
    def validate(self) -> None:
        """
        Validate the configuration object.
        """
        pass

    @abstractmethod
    def check_if_configured(self) -> bool:
        """
        Check if the configuration object is configured.
        :return: True if configured, False otherwise.
        """
        pass

    def unconfigure(self) -> None:
        """
        Unconfigure the configuration object.
        """
        if not self.check_if_configured():
            logger.warning(f"{self.name} is not configured, nothing to unconfigure.")
            return

        logger.info(f"Unconfiguring configuration object.")
        try:
            self._unconfigure()
            logger.info(f"{self.name} unconfigured successfully.")
        except Exception as e:
            logger.error(f"{self.name} unconfiguration failed: {e}")
            raise

        logger.info(f"{self.name} state: {self.get_state()}")

    @abstractmethod
    def _unconfigure(self) -> None:
        """
        Unconfigure the configuration object.
        """
        pass


# *** Concrete Configuration Objects *******************************************
class UserDirectoryConfiguration(ConfigurationObject):
    def __init__(
        self,
        commands_runner: CommandsRunner,
        file_system_controller: FileSystemController,
        configuration_path: str,
    ):
        """
        Initialize the UserDirectoryConfiguration object.
        :param commands_runner: The commands runner.
        :param file_system_controller: The file system controller.
        :param configuration_path: The path to the user directory.
        """
        super().__init__()
        self._commands_runner: CommandsRunner = commands_runner
        self._file_system_controller: FileSystemController = file_system_controller
        self._user_directory: str = file_system_controller.expanduser(
            configuration_path
        )

    @property
    @override
    def dependencies(self) -> list[ConfigurationObject]:
        return []

    @property
    @override
    def name(self) -> str:
        return "User Directory Configuration"

    @property
    @override
    def user_directory(self) -> str:
        return self._user_directory

    @property
    def _git_directory(self) -> str:
        return self._file_system_controller.join(self.user_directory, ".git")

    @override
    def get_state(self) -> str:
        try:
            if self.check_if_configured():
                return "Not Configured"
            self.validate()
            return "Configured"
        except Exception as e:
            return f"Not Configured correctly: {str(e)}"

    @override
    def _configure(self) -> None:
        self._file_system_controller.create_directory(self.user_directory)
        self._commands_runner.run_command("git init", [self.user_directory])

    @override
    def validate(self) -> None:
        self._file_system_controller.assert_directory_exists(
            self.user_directory,
            f"User directory {self.user_directory} does not exist.",
        )
        self._file_system_controller.assert_directory_exists(
            self._git_directory,
            f"User directory {self.user_directory} is not a git repository.",
        )

    @override
    def check_if_configured(self) -> bool:
        if not self._file_system_controller.exists(self.user_directory):
            return False
        if not self._file_system_controller.is_directory(self.user_directory):
            raise Exception(
                f"User directory {self.user_directory} exists but is not a directory. Consider removing it."
            )

    @override
    def _unconfigure(self) -> None:
        self._file_system_controller.remove_directory(self.user_directory)


# *** Functions ****************************************************************
def setup_logging(level: int, console_level: Optional[int] = None, file_path: Optional[str] = None) -> None:
    logger.setLevel(level)
    logger.addFilter(ContextFilter())
    format = "[%(asctime)s][%(levelname)s][%(context)s] %(filename)s:%(lineno)d: %(message)s"
    formatter = logging.Formatter(format)
    color_formatter = ColoredFormatter(
        "%(log_color)s" + format,
        reset=True,
        log_colors={
            "DEBUG": "cyan",
            "INFO": "green",
            "WARNING": "yellow",
            "ERROR": "red",
            "CRITICAL": "red,bg_white",
        },
    )
    console_handler = logging.StreamHandler(sys.stdout)
    console_handler.setFormatter(color_formatter)
    console_handler.setLevel(console_level or level)
    logger.addHandler(console_handler)
    if file_path:
        file_handler = logging.FileHandler(file_path)
        file_handler.setFormatter(formatter)
        file_handler.setLevel(level)
        logger.addHandler(file_handler)


# *** Main *********************************************************************
def main():
    """
    Main function to run the Raven DE installer.
    """
    setup_logging(logging.DEBUG, logging.INFO)
    logger.info("Raven DE Installer")
    logger.info("Starting Raven DE installer.")
    logger.info("Running in dry run mode.")

    commands_runner = CommandsRunner(dry_run=True)
    file_system_controller = FileSystemController(dry_run=True)
    user_directory = os.path.join(
        file_system_controller.get_home_directory(), ".raven-de"
    )
    user_directory_config = UserDirectoryConfiguration(
        commands_runner=commands_runner,
        file_system_controller=file_system_controller,
        configuration_path=user_directory,
    )
    user_directory_config.configure()
    user_directory_config.validate()
    logger.info(f"User configuration state: {user_directory_config.get_state()}")
    user_directory_config.unconfigure()


if __name__ == "__main__":
    main()
